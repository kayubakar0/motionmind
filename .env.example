# .env untuk deployment VPS — salin jadi .env di root repo: cp .env.example .env
# Nilai GANTI-* wajib diganti (openssl rand -hex N / password kuat).
# Setelah data tersimpan (token Strava / API key AI), APP_SECRET TIDAK BOLEH diubah.

DB_HOST=db
DB_PORT=5432
DB_DATABASE=motionmind
DB_USERNAME=motionmind
DB_PASSWORD=GANTI-openssl-rand-hex-24

PORT=3000
UPLOAD_DIR=/data/uploads

CLIENT_URL=https://motionmind.my.id
VITE_SERVER_URL=https://motionmind.my.id

APP_SECRET=GANTI-openssl-rand-hex-32
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=GANTI-password-kuat
