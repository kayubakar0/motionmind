{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "fast-xml-parser": "^5.2.5",
    "fit-file-parser": "^1.9.5",
    "hono": "^4.6.16",
    "postgres": "^3.4.7",
    "shared": "workspace:*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bun": "^1.2.15",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.7.2"
  }
}
